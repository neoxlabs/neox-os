{
  "name": "neox-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NeoX OS — a self-hosted operating system for AI agents",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:boundary": "node tools/forbidden-words.mjs",
    "check": "npm run lint:boundary && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
